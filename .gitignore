results/
# Downloaded Kaggle Benchmarks run outputs (codegen_results/, egress_results/, pred_results/, …)
*_results/
*.pyc
__pycache__/
.env
*.log
reference.q

# Author-held reference solutions — committing them would leak the benchmark.
# verify_reference.py reads these to reproduce a "solutions pass" guarantee.
solutions/

# Local Kaggle Benchmarks virtualenv + per-run scratch (the task itself IS tracked).
.venv-kaggle/
kaggle-benchmark/.env
kaggle-benchmark/*.run.json
kaggle-benchmark/*.task.json
kaggle-benchmark/example_task.py
kaggle-benchmark/kaggle_benchmarks_reference.md

# Rendered code-gen task (has the live judge URL + token baked in for push).
# Commit the template (kdb_q_codegen.py) — never the rendered copy.
kaggle-benchmark/kdb_q_codegen.rendered.py
